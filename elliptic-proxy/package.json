{
  "name": "@starkware-libs/elliptic-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "gcp-build": "tsc",
    "start": "functions-framework --target=ellipticProxy --source=dist/",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "prettier --check src/ tests/ && eslint src/ tests/ && tsc --noEmit",
    "format": "prettier --write src/ tests/ && eslint --fix src/ tests/"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@google-cloud/secret-manager": "^5.6.0",
    "@scure/starknet": "^1.1.2",
    "lru-cache": "^11.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.17",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.1"
  },
  "overrides": {
    "protobufjs": "^7.6.6",
    "@grpc/grpc-js": "^1.14.5",
    "form-data": "^2.5.6",
    "fast-uri": "^3.1.6",
    "postcss": "^8.5.18",
    "nanoid": "^3.3.12",
    "js-yaml": "^4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.16"
    },
    "minimatch@10.2.4": {
      "brace-expansion": "^5.0.7"
    }
  }
}
